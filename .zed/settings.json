{
	"languages": {
		"Svelte": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "pnpm",
					"arguments": ["exec", "oxfmt", "--stdin-filepath", "{buffer_path}"]
				}
			},
			"language_servers": ["!oxlint", "svelte-language-server", "tailwindcss-language-server"]
		},
