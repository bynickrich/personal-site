{
	"file_types": {
		"Svelte": ["svelte", "svx"]
	},
	"lsp": {
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": null
				}
			}
		},
		"tailwindcss-language-server": {
			"settings": {
				"includeLanguages": {
					"svelte": "html"
				},
				"classFunctions": ["tv", "cx"],
				"experimental": {
					"classRegex": [
						"class=\\\"([^\\\"]*)\\\"",
						"class='([^']*)'",
						"class:\\\\s*([^\\\\s{]+)",
						"\\\\{\\\\s*class:\\\\s*\\\"([^\\\"]*)\\\"",
						"\\\\{\\\\s*class:\\\\s*'([^']*)'"
					]
				}
			}
		}
	},
	"languages": {
		"Svelte": {
			"semantic_tokens": "combined",
			"language_servers": [
				"svelte-language-server",
				"tailwindcss-language-server",
				"oxfmt",
				"!oxlint",
				"..."
			],
			"hard_tabs": true,
			"tab_size": 2,
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"format_on_save": "on"
		},
		"CSS": {
			"language_servers": [
				"tailwindcss-intellisense-css",
				"!vscode-css-language-server",
				"oxfmt",
				"..."
			],
			"hard_tabs": true,
			"tab_size": 2,
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"format_on_save": "on"
		},
		"TypeScript": {
			"semantic_tokens": "combined",
			"language_servers": ["oxfmt", "!oxlint", "..."],
			"hard_tabs": true,
			"tab_size": 2,
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
